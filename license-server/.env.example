# 数据库（本地 SQLite，生产环境切换为 MySQL）
DATABASE_URL=sqlite:///./license.db
# DATABASE_URL=mysql+pymysql://license:password@localhost/license_db

# JWT 配置
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
TOKEN_EXPIRE_HOURS=24

# 授权码签名密钥（第五节定义）
LICENSE_SIGNING_KEY=your-secret-signing-key-min-32-chars
CACHE_SIGNING_SECRET=another-secret-key-for-cache

# 外部 API（代理模式使用）
DEEPSEEK_API_KEY=
IFLYTEK_APP_ID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=

# 离线宽限期（天）
OFFLINE_GRACE_DAYS=7

# 心跳间隔（秒）
HEARTBEAT_INTERVAL_SEC=1800
